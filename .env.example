# ==========================================
# LearnGap AI - Environment Configuration
# ==========================================

# Server & Security
PROJECT_NAME="LearnGap AI"
API_V1_STR="/api/v1"
SECRET_KEY="generate-a-secure-random-256-bit-key-here-for-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Use PostgreSQL in production (e.g., Supabase, Neon, AWS RDS, DigitalOcean)
# Local development defaults to sqlite:///./learngap.db if omitted
DATABASE_URL="postgresql://learngap_user:your_secure_password@db.example.com:5432/learngap_production"

# CORS Allowed Origins
# Comma-separated or JSON list of frontend production URLs
BACKEND_CORS_ORIGINS='["https://learngap.school.edu", "http://localhost:5173"]'

# AI Service Configuration
# Options: 'rule_based' (default, 100% offline, zero downtime), 'gemini', 'openai'
AI_PROVIDER="rule_based"

# Optional Cloud LLM Keys (only required if AI_PROVIDER is set to gemini or openai)
GEMINI_API_KEY="your-gemini-api-key-here"
OPENAI_API_KEY="your-openai-api-key-here"

# School Data Retention & Compliance
DEFAULT_DATA_RETENTION_DAYS=365
ANONYMIZE_AI_DATA=true
